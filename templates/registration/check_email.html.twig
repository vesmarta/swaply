{% extends 'base.html.twig' %}

{% block title %}Check your email — Swaply{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card-soft auth-card mx-auto p-4 p-md-5 text-center">
            <div class="feature-icon mx-auto mb-3"><i class="bi bi-envelope-check"></i></div>
            <h1 class="h4 fw-bold mb-2">Check your inbox</h1>
            <p class="text-muted mb-4">
                We sent you a verification link. Click it to activate your Swaply account —
                the link expires in 48 hours.
            </p>
            <div class="alert alert-info small text-start mb-4">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Development:</strong> emails are captured locally by Mailpit — open
                <a href="http://127.0.0.1:8025" target="_blank" rel="noopener">http://127.0.0.1:8025</a>
                to view the verification email.
            </div>
            <a href="{{ path('app_login') }}" class="btn btn-brand px-4">Go to login</a>
        </div>
    </div>
{% endblock %}
