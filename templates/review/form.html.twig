{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Review your deal — Swaply{% endblock %}

{% block body %}
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="{{ path('app_listing_show', {id: listing.id}) }}">{{ listing.title }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">Review</li>
            </ol>
        </nav>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-6">
                <div class="card-soft p-4 p-md-5">
                    <h1 class="h4 fw-bold mb-1">Rate your deal</h1>
                    <p class="text-muted small mb-4">
                        How did it go with <strong>{{ counterpart.fullName }}</strong> (@{{ counterpart.username }}) on <em>{{ listing.title }}</em>?
                    </p>

                    {{ form_start(form) }}
                        {{ form_row(form.rating) }}
                        {{ form_row(form.comment) }}
                        <button type="submit" class="btn btn-brand w-100 py-2 fw-semibold mt-3"><i class="bi bi-star me-1"></i>Publish review</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
