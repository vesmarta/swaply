<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Swaply — Trade, negotiate, buy{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%234338ca%22/><text y=%220.95em%22 x=%220.5em%22 font-size=%2264%22 text-anchor=%22middle%22>🔁</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        <nav class="navbar navbar-expand-lg navbar-dark bg-brand sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <i class="bi bi-arrow-repeat fs-4"></i> Swaply
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'app_marketplace' ? 'active' : '' }}" href="{{ path('app_marketplace') }}">Marketplace</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        {% if app.user %}
                            <li class="nav-item d-none d-lg-block">
                                <a class="btn btn-accent btn-sm" href="{{ path('app_listing_new') }}"><i class="bi bi-plus-lg me-1"></i>List an item</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ app.current_route == 'app_dashboard' ? 'active' : '' }}" href="{{ path('app_dashboard') }}">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>{{ app.user.username }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('app_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_my_listings') }}"><i class="bi bi-box-seam me-2"></i>My listings</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_offers') }}"><i class="bi bi-arrow-left-right me-2"></i>My offers</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_purchases') }}"><i class="bi bi-bag-check me-2"></i>My purchases</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_messages') }}"><i class="bi bi-chat-dots me-2"></i>Messages</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_favorites') }}"><i class="bi bi-heart me-2"></i>Favorites</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person-gear me-2"></i>My profile</a></li>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="{{ path('app_admin') }}"><i class="bi bi-shield-check me-2"></i>Moderation</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_admin_users') }}"><i class="bi bi-people me-2"></i>Members</a></li>
                                    {% endif %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Log out</a></li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-accent btn-sm px-3" href="{{ path('app_register') }}">Sign up free</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="flex-grow-1">
            {% if app.user and not app.user.isVerified %}
                <div class="container mt-3">
                    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2 mb-0" role="alert">
                        <span><i class="bi bi-exclamation-triangle me-2"></i>Your email address is not verified yet. Verify it to unlock all features.</span>
                        <a href="{{ path('app_resend_verification') }}" class="btn btn-sm btn-outline-dark">Resend verification email</a>
                    </div>
                </div>
            {% endif %}

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="container mt-3">
                        <div class="alert alert-{{ type }} alert-dismissible fade show mb-0" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="bg-white border-top mt-5 py-4">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-muted">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-repeat text-primary"></i> <strong class="text-dark">Swaply</strong> — peer-to-peer trading in Tunisia
                </span>
                <span>&copy; {{ "now"|date("Y") }} Swaply. All prices in TND.</span>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
