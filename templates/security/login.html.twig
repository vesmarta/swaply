{% extends 'base.html.twig' %}

{% block title %}Log in — Swaply{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card-soft auth-card mx-auto p-4 p-md-5">
            <h1 class="h3 fw-bold mb-1">Welcome back</h1>
            <p class="text-muted mb-4">Log in to manage your listings and trades.</p>

            {% if error %}
                <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label class="form-label" for="username">Email address</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-brand w-100 py-2 fw-semibold" type="submit">Log in</button>
            </form>

            <div class="d-flex justify-content-between mt-4 small">
                <a href="{{ path('app_forgot_password_request') }}">Forgot your password?</a>
                <a href="{{ path('app_register') }}">Create an account</a>
            </div>
        </div>
    </div>
{% endblock %}
