{% extends 'base.html.twig' %}

{% form_theme requestForm 'bootstrap_5_layout.html.twig' %}

{% block title %}Forgot password — Swaply{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card-soft auth-card mx-auto p-4 p-md-5">
            <h1 class="h3 fw-bold mb-1">Forgot your password?</h1>
            <p class="text-muted mb-4">Enter your email address and we will send you a link to reset it.</p>

            {{ form_start(requestForm) }}
                {{ form_row(requestForm.email) }}
                <button type="submit" class="btn btn-brand w-100 py-2 fw-semibold mt-3">Send reset link</button>
            {{ form_end(requestForm) }}

            <p class="text-center small mt-4 mb-0"><a href="{{ path('app_login') }}">Back to login</a></p>
        </div>
    </div>
{% endblock %}
