{% extends 'base.html.twig' %}

{% block title %}Reset link sent — Swaply{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card-soft auth-card mx-auto p-4 p-md-5 text-center">
            <div class="feature-icon mx-auto mb-3"><i class="bi bi-envelope-paper"></i></div>
            <h1 class="h4 fw-bold mb-2">Check your email</h1>
            <p class="text-muted mb-4">
                If an account exists for that address, we have sent a password reset link.
                The link expires in 1 hour.
            </p>
            <div class="alert alert-info small text-start mb-4">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Development:</strong> open
                <a href="http://127.0.0.1:8025" target="_blank" rel="noopener">http://127.0.0.1:8025</a>
                to view the email captured by Mailpit.
            </div>
            <a href="{{ path('app_login') }}" class="btn btn-brand px-4">Back to login</a>
        </div>
    </div>
{% endblock %}
