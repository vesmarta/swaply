{% extends 'base.html.twig' %}

{% block title %}Purchase #{{ purchase.id }} — Swaply{% endblock %}

{% block body %}
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_purchases') }}">My purchases</a></li>
                <li class="breadcrumb-item active" aria-current="page">Purchase #{{ purchase.id }}</li>
            </ol>
        </nav>

        {% if purchase.status.value == 'completed' %}
            <div class="alert alert-success"><i class="bi bi-check2-circle me-2"></i>This purchase is completed — the item is marked as sold.</div>
        {% elseif purchase.status.value == 'accepted' %}
            <div class="alert alert-info"><i class="bi bi-handshake me-2"></i>The seller accepted. The item is reserved until you both confirm the handover.</div>
        {% elseif purchase.status.value == 'rejected' %}
            <div class="alert alert-danger"><i class="bi bi-x-octagon me-2"></i>The seller declined this purchase request.</div>
        {% elseif purchase.status.value == 'cancelled' %}
            <div class="alert alert-secondary"><i class="bi bi-slash-circle me-2"></i>This purchase request was cancelled by the buyer.</div>
        {% endif %}

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card-soft p-4">
                    <h1 class="h4 fw-bold mb-1">Direct purchase</h1>
                    <p class="text-muted small mb-4">
                        <strong>@{{ purchase.buyer.username }}</strong> wants to buy from <strong>@{{ purchase.seller.username }}</strong>.
                    </p>

                    <div class="d-flex align-items-center gap-3 border rounded-3 p-3 mb-3">
                        {% if purchase.listing.coverImage %}
                            <img src="{{ asset('uploads/listings/' ~ purchase.listing.coverImage.filename) }}" alt="{{ purchase.listing.title }}" class="rounded-2" style="width: 84px; height: 84px; object-fit: cover;">
                        {% else %}
                            <div class="d-flex align-items-center justify-content-center bg-light rounded-2 text-secondary" style="width: 84px; height: 84px;"><i class="bi bi-image fs-3"></i></div>
                        {% endif %}
                        <div class="flex-grow-1">
                            <a href="{{ path('app_listing_show', {id: purchase.listing.id}) }}" class="fw-semibold text-decoration-none">{{ purchase.listing.title }}</a>
                            <div class="small text-muted">Requested {{ purchase.createdAt|date('d M Y H:i') }}</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold fs-5">{{ purchase.priceMillimes|tnd }} <span class="small text-muted">TND</span></div>
                        </div>
                    </div>

                    {% if purchase.message %}
                        <div class="small bg-light rounded-3 p-3" style="white-space: pre-line;">{{ purchase.message }}</div>
                    {% endif %}

                    {% if purchase.respondedAt and purchase.status.value in ['accepted', 'rejected', 'cancelled', 'completed'] %}
                        <div class="small text-muted mt-3">Answered {{ purchase.respondedAt|date('d M Y H:i') }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card-soft p-4">
                    {% if purchase.status.value == 'pending' %}
                        <h2 class="h6 fw-bold mb-2">
                            {% if purchase.seller == app.user %}Respond to this request{% else %}Waiting for the seller{% endif %}
                        </h2>
                        <p class="small text-muted mb-3">
                            {% if purchase.seller == app.user %}
                                Accepting reserves the item for this buyer and declines other pending purchase requests.
                            {% else %}
                                {{ purchase.seller.fullName }} will accept or decline your request.
                            {% endif %}
                        </p>

                        {% if purchase.seller == app.user %}
                            <div class="d-flex flex-column gap-2">
                                <form method="post" action="{{ path('app_purchase_accept', {id: purchase.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('purchase_action_' ~ purchase.id) }}">
                                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-check2-circle me-1"></i>Accept purchase</button>
                                </form>
                                <form method="post" action="{{ path('app_purchase_reject', {id: purchase.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('purchase_action_' ~ purchase.id) }}">
                                    <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Decline this purchase request?')">Decline</button>
                                </form>
                            </div>
                        {% else %}
                            <form method="post" action="{{ path('app_purchase_cancel', {id: purchase.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('purchase_action_' ~ purchase.id) }}">
                                <button type="submit" class="btn btn-outline-secondary w-100" onclick="return confirm('Cancel this purchase request?')">Cancel my request</button>
                            </form>
                        {% endif %}
                    {% elseif purchase.status.value == 'accepted' %}
                        <h2 class="h6 fw-bold mb-3">Confirm the handover</h2>
                        <ul class="list-unstyled small mb-3">
                            <li class="d-flex justify-content-between border-bottom py-2">
                                <span>@{{ purchase.buyer.username }} (buyer)</span>
                                <span>{{ purchase.buyerConfirmedAt ? purchase.buyerConfirmedAt|date('d M Y') : 'Waiting…' }}</span>
                            </li>
                            <li class="d-flex justify-content-between py-2">
                                <span>@{{ purchase.seller.username }} (seller)</span>
                                <span>{{ purchase.sellerConfirmedAt ? purchase.sellerConfirmedAt|date('d M Y') : 'Waiting…' }}</span>
                            </li>
                        </ul>
                        {% set myConfirmed = purchase.buyer == app.user ? purchase.buyerConfirmedAt : purchase.sellerConfirmedAt %}
                        {% if not myConfirmed %}
                            <form method="post" action="{{ path('app_purchase_confirm', {id: purchase.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('purchase_action_' ~ purchase.id) }}">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-hand-thumbs-up me-1"></i>
                                    {% if purchase.buyer == app.user %}I confirm I received "{{ purchase.listing.title }}"{% else %}I confirm I handed over "{{ purchase.listing.title }}"{% endif %}
                                </button>
                            </form>
                        {% else %}
                            <div class="alert alert-success small mb-0">You confirmed this purchase. Waiting for the other party.</div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
