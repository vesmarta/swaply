{% extends 'base.html.twig' %}

{% block title %}My purchases — Swaply{% endblock %}

{% macro purchase_row(purchase, perspective) %}
    <tr>
        <td>
            <a href="{{ path('app_listing_show', {id: purchase.listing.id}) }}" class="fw-semibold text-decoration-none">{{ purchase.listing.title }}</a>
            <div class="small text-muted">
                {{ perspective == 'buying' ? 'from @' ~ purchase.seller.username : 'buyer @' ~ purchase.buyer.username }}
            </div>
        </td>
        <td class="text-end">{{ purchase.priceMillimes|tnd }} TND</td>
        <td class="text-center"><span class="badge text-bg-{{ purchase.status.badge }}">{{ purchase.status.label }}</span></td>
        <td class="text-end small text-muted">{{ purchase.createdAt|date('d M Y') }}</td>
        <td class="text-end"><a href="{{ path('app_purchase_show', {id: purchase.id}) }}" class="btn btn-sm btn-outline-secondary">View</a></td>
    </tr>
{% endmacro %}

{% import _self as m %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">My purchases</h1>
                <p class="text-muted small mb-0">Buy requests you sent and sales requests you received.</p>
            </div>
            <a href="{{ path('app_marketplace') }}" class="btn btn-outline-secondary"><i class="bi bi-grid me-1"></i>Browse marketplace</a>
        </div>

        <h2 class="h6 fw-bold mb-2"><i class="bi bi-bag me-1"></i>Items I'm buying</h2>
        {% if buying is empty %}
            <div class="card-soft p-4 text-center text-muted small mb-4">No purchases yet. Buy-now items from the marketplace will appear here.</div>
        {% else %}
            <div class="card-soft p-0 mb-4 overflow-hidden">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Item</th><th class="text-end">Price</th><th class="text-center">Status</th><th class="text-end">Requested</th><th></th></tr></thead>
                    <tbody>
                        {% for purchase in buying %}{{ m.purchase_row(purchase, 'buying') }}{% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <h2 class="h6 fw-bold mb-2"><i class="bi bi-cash-coin me-1"></i>Items I'm selling</h2>
        {% if selling is empty %}
            <div class="card-soft p-4 text-center text-muted small">No sale requests yet. Buy-now requests on your listings will appear here.</div>
        {% else %}
            <div class="card-soft p-0 overflow-hidden">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Item</th><th class="text-end">Price</th><th class="text-center">Status</th><th class="text-end">Requested</th><th></th></tr></thead>
                    <tbody>
                        {% for purchase in selling %}{{ m.purchase_row(purchase, 'selling') }}{% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
